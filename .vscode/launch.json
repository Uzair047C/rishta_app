{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (NestJS)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Backend (Attach)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "cwd": "${workspaceFolder}/backend",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Frontend (Flutter Web)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": [
        "-d", "chrome",
        "--dart-define=API_BASE=http://localhost:3001"
      ],
      "flutterMode": "debug"
    },
    {
      "name": "Debug Frontend (Flutter Windows)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": [
        "-d", "windows",
        "--dart-define=API_BASE=http://localhost:3001"
      ],
      "flutterMode": "debug"
    },
    {
      "name": "Debug Full Stack (Backend + Frontend)",
      "type": "compound",
      "configurations": [
        "Debug Backend (NestJS)",
        "Debug Frontend (Flutter Web)"
      ],
      "preLaunchTask": "Start Backend",
      "stopAll": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": [
        "Debug Backend (NestJS)",
        "Debug Frontend (Flutter Web)"
      ],
      "stopAll": true
    }
  ]
}