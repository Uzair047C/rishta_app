# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rishta

PORT=3000

# Firebase Admin. Paste the service-account JSON as base64 so it survives .env
# single-line parsing:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Stream Chat — backend issues user tokens after Firebase auth succeeds.
STREAM_API_KEY=
STREAM_API_SECRET=

# Moderation / verification providers. When unset the service runs in
# passthrough mode (logs a warning, auto-approves) — see ModerationService.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_FACE_MATCH_THRESHOLD=90

OPENAI_API_KEY=

# Comma-separated default daily like allowance for the free plan.
FREE_PLAN_DAILY_LIKES=10

# Shared secret RevenueCat sends in the Authorization header. Without it the
# subscription webhook refuses every request.
REVENUECAT_WEBHOOK_SECRET=

# users.id values allowed to reach /admin. Find yours via GET /admin/whoami
# after temporarily adding yourself to this list.
ADMIN_USER_IDS=
