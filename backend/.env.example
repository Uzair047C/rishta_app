# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rishta

PORT=3000

# JWT authentication (fail startup if unset)
JWT_SECRET=

# Google OAuth client IDs (comma-separated, supports web+Android+iOS; required)
# Web client ID is used as serverClientId in Flutter google_sign_in
GOOGLE_CLIENT_IDS=385499016700-h822cufamapr6ad2ujcj8d3t3hc8ec6o.apps.googleusercontent.com

# Stream Chat — backend issues user tokens after Google auth succeeds.
STREAM_API_KEY=
STREAM_API_SECRET=

# Moderation / verification providers. When unset the service runs in
# passthrough mode (logs a warning, auto-approves) — see ModerationService.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_FACE_MATCH_THRESHOLD=90

OPENAI_API_KEY=

# Comma-separated default daily like allowance for the free plan.
FREE_PLAN_DAILY_LIKES=10

# Shared secret RevenueCat sends in the Authorization header. Without it the
# subscription webhook refuses every request.
REVENUECAT_WEBHOOK_SECRET=

# Admin token for /admin endpoints. Required in production.
ADMIN_TOKEN=

# CORS allowed origins (comma-separated). Required for credentialed requests.
# Use CORS_ORIGIN (singular) for new deployments; CORS_ORIGINS kept for compat.
# Example: CORS_ORIGIN=http://localhost:3000,https://app.example.com
CORS_ORIGIN=
