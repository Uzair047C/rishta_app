{
  "name": "rishta-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:create": "node-pg-migrate create",
    "db:migrate:down": "node-pg-migrate down",
    "db:seed": "node seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.716.0",
    "@nestjs-redis/throttler-storage": "^2.0.1",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/helmet": "^0.0.48",
    "@types/joi": "^17.2.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "pg": "^8.13.3",
    "pg-boss": "^12.38.0",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stream-chat": "^9.54.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.8.2"
  },
  "migrate": {
    "tableName": "migrations",
    "migrationsDir": "sql/migrations",
    "driver": "pg",
    "databaseUrl": "postgresql://user:pass@localhost:5432/rishta"
  }
}
